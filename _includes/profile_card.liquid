<div class="col-lg-4 col-md-6 d-flex align-items-stretch mb-4">
  <div class="card profile-card w-100">
    <div class="card-body text-left">
      <!-- Profile Image -->
      {% if include.profile.image %}
        {% assign profile_image_path = include.profile.image | prepend: 'assets/img/' %}
        {% if include.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle mb-3' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded mb-3' %}
        {% endif %}
        <a href="{{ include.profile.hyperlink }}" target="_blank">
          {% include figure.liquid path = profile_image_path class = profile_image_class sizes = sizes alt = include.profile.image %}
        </a>
      {% endif %}

      <!-- Profile Name -->
      {% if include.profile.name %}
        <h5 class="card-title">{{ include.profile.name }}</h5>
      {% endif %}

      <!-- Profile Email -->
      {% if include.profile.more_info %}
        <p class="card-text">{{ include.profile.more_info }}</p>
      {% endif %}

      <!-- Profile Content -->
      <div class="clearfix">
        {% if include.profile.content %}
          {% capture profile_content %}{% include_relative {{ include.profile.content }} %}{% endcapture %}
          <p class="card-text">{{ profile_content | markdownify }}</p>
        {% else %}
          <p class="card-text">{{ include.content }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
