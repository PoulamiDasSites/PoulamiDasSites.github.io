<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% comment %} Pinned items always show, placed after the newest items {% endcomment %}
        {% assign all_news = site.news | reverse %}
        {% assign pinned_news = all_news | where: 'pinned', true %}
        {% assign other_news = all_news | where_exp: 'item', 'item.pinned != true' %}
        {% if include.limit and site.announcements.limit %}
          {% assign pinned_size = pinned_news | size %}
          {% assign other_limit = site.announcements.limit | minus: pinned_size %}
          {% assign news = other_news | slice: 0, other_limit | concat: pinned_news %}
        {% else %}
          {% assign news = all_news %}
        {% endif %}
        {% for item in news %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
