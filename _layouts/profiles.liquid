---
layout: page
---
<div class="post">
  <article>
    {% if page.profiles %}
      <div class="profiles-page">
      <div class="container">
        {% if page.graduated %}
          <h4 class="profile-group-title">Current Students</h4>
        {% endif %}
        <div class="row">
          {% for profile in page.profiles %}
            {% include profile_card.liquid profile = profile content = content %}
          {% endfor %}
        </div>

        {% if page.graduated %}
          <h4 class="profile-group-title">Graduated Students</h4>
          <div class="row">
            {% for profile in page.graduated %}
              {% include profile_card.liquid profile = profile content = content %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
      </div>
    {% endif %}
  </article>
</div>
